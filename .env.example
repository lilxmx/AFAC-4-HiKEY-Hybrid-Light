# Copy this file to .env and fill in credentials locally. Never commit .env.

# Qwen / DashScope
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Optional m02 GPT-4.1 / Azure OpenAI configuration
AZURE_API_KEY=
AZURE_ENDPOINT=
AZURE_BASE_URL=
AZURE_API_VERSION=2024-12-01-preview

# Optional OpenRouter embedding configuration
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional network proxy; leave empty unless required in your environment.
http_proxy=
https_proxy=
